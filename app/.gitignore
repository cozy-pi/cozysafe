/lib/src/rust/
/rust/src/frb_generated.rs
/lib/l10n/app_localizations*.dart

# Rendered by the screenshots workflow, not committed.
/test/screenshots/
test/preview/
test/preview_assets/
lib/preview/photos.g.dart
