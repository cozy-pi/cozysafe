#!/bin/sh
# Cut app/assets/fonts/MaterialSymbolsRounded.ttf: the glyphs lib/widgets/symbols.dart
# names, from Material Symbols Rounded at a pinned commit, as a static instance (FILL 1,
# GRAD 0, opsz 24, wght 500). The same input gives the same bytes (SOURCE_DATE_EPOCH is
# the commit's time). Needs fontTools 4.60.1 exactly (checked below).
#
#   tools/symbols-font <work dir> key shield_lock pin ...
#
# Downloads two files from GitHub into <work dir> and checks their SHA-256 first;
# assets/fonts/README.md records the source, the hashes and the glyph list.
set -eu
COMMIT=10ecc14790612ca8fd164e3f4ffe9c16fc50d5b7
TTF_SHA=7e74e36533ccee12c2b81e75bfcf3ccf123d3bb7e7e46d65d94445f23db0c97c
CP_SHA=a7404d9e5a1b63f496cf05ace45d386075886b5a7f123fba9f29527cb6006fde
export SOURCE_DATE_EPOCH=1792721923
# Byte for byte only with the fontTools that made the committed font.
FONTTOOLS=4.60.1
have=$(python3 -c 'import fontTools; print(fontTools.version)' 2>/dev/null || true)
if [ "$have" != "$FONTTOOLS" ]; then
  echo "needs fontTools $FONTTOOLS (found: ${have:-none}): pip install fonttools==$FONTTOOLS in a venv" >&2
  exit 1
fi
REPO=$(cd "$(dirname "$0")/.." && pwd)
WORK=$1
shift
mkdir -p "$WORK"
cd "$WORK"
BASE="https://raw.githubusercontent.com/google/material-design-icons/$COMMIT/variablefont"
[ -f rounded.ttf ] || curl -sSfL -o rounded.ttf "$BASE/MaterialSymbolsRounded%5BFILL,GRAD,opsz,wght%5D.ttf"
[ -f rounded.codepoints ] || curl -sSfL -o rounded.codepoints "$BASE/MaterialSymbolsRounded%5BFILL,GRAD,opsz,wght%5D.codepoints"
echo "$TTF_SHA  rounded.ttf" | shasum -a 256 -c -
echo "$CP_SHA  rounded.codepoints" | shasum -a 256 -c -
U=""
for name in "$@"; do
  cp=$(grep -E "^$name " rounded.codepoints | head -1 | cut -d' ' -f2)
  [ -n "$cp" ] || { echo "no glyph named $name" >&2; exit 1; }
  echo "$name U+$cp"
  U="$U,U+$cp"
done
fonttools varLib.instancer rounded.ttf FILL=1 GRAD=0 opsz=24 wght=500 -o static.ttf -q
pyftsubset static.ttf --unicodes="${U#,}" --layout-features='' --no-hinting --desubroutinize \
  --name-IDs='*' --output-file="$REPO/app/assets/fonts/MaterialSymbolsRounded.ttf"
shasum -a 256 "$REPO/app/assets/fonts/MaterialSymbolsRounded.ttf"
