#!/usr/bin/env bash
# Fail if a built APK or app bundle asks for a network permission beyond INTERNET.
#   tools/check-apk-permissions CozySafe-android.apk [CozySafe-android-play.aab]
# INTERNET is there for syncing with a nearby device (Android needs it for any socket,
# even on the local Wi-Fi); everything else about the network (state, Wi-Fi control,
# nearby devices) stays out. Checks the merged result in the real files. APKs need
# aapt2 from the Android SDK build-tools ($ANDROID_HOME).
# Not network permissions, so not refused here: FOREGROUND_SERVICE,
# FOREGROUND_SERVICE_DATA_SYNC and POST_NOTIFICATIONS keep a sync running with the phone
# locked (a foreground service with a progress notification, only while a sync runs;
# app/android/.../SyncService.kt). They add no way to reach the network.
set -euo pipefail
status=0
for f in "$@"; do
  case "$f" in
    *.apk)
      aapt2=$(ls "${ANDROID_HOME:?ANDROID_HOME not set}"/build-tools/*/aapt2 | sort -V | tail -1)
      perms=$("$aapt2" dump permissions "$f")
      ;;
    *.aab)
      # The bundle's manifest is protobuf; permission names are stored as plain strings.
      perms=$(unzip -p "$f" base/manifest/AndroidManifest.xml | LC_ALL=C grep -ao 'android\.permission\.[A-Z_]*' | sort -u)
      ;;
    *) echo "error: $f is not an .apk or .aab" >&2; exit 2 ;;
  esac
  echo "== $f"
  echo "$perms"
  for p in ACCESS_NETWORK_STATE ACCESS_WIFI_STATE CHANGE_NETWORK_STATE CHANGE_WIFI_STATE \
    CHANGE_WIFI_MULTICAST_STATE NEARBY_WIFI_DEVICES BLUETOOTH_CONNECT BLUETOOTH_SCAN; do
    if grep -q "android.permission.$p\b" <<<"$perms"; then
      echo "error: $f requests android.permission.$p; only INTERNET (local sync) is allowed" >&2
      status=1
    fi
  done
done
exit $status
