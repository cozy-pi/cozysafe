#!/usr/bin/env python3
"""Fail if the macOS release build could reach the network.

  tools/check-entitlements [path/to/Release.entitlements]

The release app must run in the App Sandbox, and the sandbox must not grant any
network entitlement (com.apple.security.network.client / .server, or anything else
under com.apple.security.network.*). With the sandbox on and no such entitlement,
macOS refuses every socket the app or any library in it opens.
DebugProfile.entitlements keeps network.server: Flutter's debugger needs it.
"""

import plistlib
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
path = Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT / "app/macos/Runner/Release.entitlements"
ent = plistlib.loads(path.read_bytes())

errors = []
if ent.get("com.apple.security.app-sandbox") is not True:
    errors.append("com.apple.security.app-sandbox must be <true/>")
for key, value in ent.items():
    if key.startswith("com.apple.security.network.") and value is not False:
        errors.append(f"{key} grants network access")
    # A temporary exception can punch holes in the sandbox (e.g. mach-lookup to a
    # network helper); none is needed today.
    if key.startswith("com.apple.security.temporary-exception."):
        errors.append(f"{key}: sandbox exceptions need review")

for e in errors:
    print(f"error: {path.name}: {e}", file=sys.stderr)
if not errors:
    print(f"{path.name}: sandboxed, no network entitlement")
sys.exit(1 if errors else 0)
