#!/usr/bin/env python3
"""Fail if the macOS release build leaves the App Sandbox or widens it.

  tools/check-entitlements [path/to/Release.entitlements]

The release app must run in the App Sandbox. Of the network entitlements only
network.client and network.server are allowed: syncing with a nearby device on the
Wi-Fi (cs-net, docs/supply-chain.md) needs both. No temporary exceptions.
"""

import plistlib
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
path = Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT / "app/macos/Runner/Release.entitlements"
ent = plistlib.loads(path.read_bytes())

errors = []
if ent.get("com.apple.security.app-sandbox") is not True:
    errors.append("com.apple.security.app-sandbox must be <true/>")
for key, value in ent.items():
    if key.startswith("com.apple.security.network.") and value is not False and key not in (
        "com.apple.security.network.client",
        "com.apple.security.network.server",
    ):
        errors.append(f"{key} grants network access")
    # A temporary exception can punch holes in the sandbox (e.g. mach-lookup to a
    # network helper); none is needed today.
    if key.startswith("com.apple.security.temporary-exception."):
        errors.append(f"{key}: sandbox exceptions need review")

for e in errors:
    print(f"error: {path.name}: {e}", file=sys.stderr)
if not errors:
    print(f"{path.name}: sandboxed, network only for local sync")
sys.exit(1 if errors else 0)
